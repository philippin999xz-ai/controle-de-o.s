# Nunca publique este arquivo com valores reais. No Render, use o painel "Environment".
# Chave do Groq (console.groq.com/keys). Fica somente no servidor; o app nunca a recebe.
GROQ_API_KEY=COLOQUE_A_CHAVE_SOMENTE_NO_RENDER
# Opcional: modelos com visão para ler a foto da O.S., na ordem de tentativa (separados por vírgula). Padrão: qwen/qwen3.8-27b
# GROQ_MODELS=qwen/qwen3.8-27b
# Opcional: raciocínio do modelo. none = direto (padrão, mais rápido e econômico); low/medium/high = raciocinar mais; vazio = não enviar.
# GROQ_REASONING=none
# Banco central: obrigatório para usuários, sessões, cargos, ordens e fotos.
TURSO_DATABASE_URL=libsql://SEU-BANCO-SEU-USUARIO.turso.io
TURSO_AUTH_TOKEN=COLOQUE_O_TOKEN_DO_BANCO_SOMENTE_NO_RENDER
# Teste local sem Turso: TURSO_DATABASE_URL=file:./teste.db
# Só se o front estiver em outro site (ex.: GitHub Pages). Vários sites separados por vírgula.
FRONTEND_ORIGIN=https://philippin999xz-ai.github.io

# Solução de problemas com pesquisa na web (ferramenta browser_search: só modelos openai/gpt-oss-*).
# Usa GROQ_API_KEY somente no servidor; não configure chaves no front-end.
# DIAGNOSTICO_MODEL=openai/gpt-oss-120b

# O primeiro administrador é criado direto no app (tela "Configure seu primeiro acesso"), sem variável.
# Opcional: em vez disso, crie-o por variável (usado só se o banco ainda não tiver usuários; depois remova ADMIN_PIN).
# ADMIN_NAME=Administrador
# ADMIN_PIN=DEFINA_UM_PIN_DE_4_A_8_NUMEROS_NO_RENDER
# APP_TOKEN não é mais usado para autenticar o navegador; cada login cria sua própria sessão.

# Alternativas opcionais: sem chave, o provedor é ignorado. Veja docs/ia-gratuita.md.
# Use contas/projetos na faixa gratuita, sem faturamento/recarga automática.
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.5-flash
# GEMINI_SEARCH_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=
# Somente openrouter/free ou IDs terminados em :free; nunca migra para modelos pagos.
# OPENROUTER_VISION_MODEL=openrouter/free
# OPENROUTER_SEARCH_MODEL=openrouter/free
# Busca web separada para OpenRouter/Cerebras/Hugging Face (não precisa para Groq/Gemini):
# TAVILY_API_KEY=
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=ID_DO_MODELO_DO_PLANO_GRATUITO
# HF_TOKEN=
# HF_MODEL=ID_DO_MODELO_TEXTO_DO_PLANO_GRATUITO
# HF_VISION_MODEL=ID_DO_MODELO_COM_VISAO_DO_PLANO_GRATUITO
# AI_SEARCH_MAX_TOKENS=2400
