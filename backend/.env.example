# Nunca publique este arquivo com valores reais. No Render, use o painel "Environment".
GEMINI_API_KEY=COLOQUE_A_CHAVE_SOMENTE_NO_RENDER
# Opcional: modelos na ordem de tentativa (separados por vírgula). Padrão: gemini-3.8-flash,gemini-3.5-flash
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash
# Opcional: nível de raciocínio (gasta token invisível). low = recomendado; vazio = não enviar.
GEMINI_THINKING=low
# Nuvem (Turso): mesmo histórico no celular e no PC. Sem estas 3, o app funciona só com dados locais.
TURSO_DATABASE_URL=libsql://SEU-BANCO-SEU-USUARIO.turso.io
TURSO_AUTH_TOKEN=COLOQUE_O_TOKEN_DO_BANCO_SOMENTE_NO_RENDER
# Sua chave de acesso (frase longa, mín. 16 caracteres). Você a digita uma vez em cada aparelho, em Ajustes.
# Com ela definida, a leitura por IA e a nuvem só respondem a quem tiver a chave (protege sua cota do Gemini).
APP_TOKEN=INVENTE-UMA-FRASE-LONGA-E-SECRETA
# Teste local sem Turso: TURSO_DATABASE_URL=file:./teste.db
# Só se o front estiver em outro site (ex.: GitHub Pages). Vários sites separados por vírgula.
FRONTEND_ORIGIN=https://philippin999xz-ai.github.io
